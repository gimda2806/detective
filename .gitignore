# dependencies
/node_modules
/.pnpm-store
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# typescript
*.tsbuildinfo

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# case generation pipeline output (unreviewed by design — see scripts/README.md)
/generated-cases/

# graphify knowledge-graph build output (regenerated locally, not source)
/graphify-out/

# 공략집은 마스터에서 생성한다 — npm run build:walkthroughs
# 커밋하면 마스터가 고쳐질 때마다 조용히 틀린 문서가 된다.
data/pending-cases/*/*.walkthrough.md
data/pending-cases/*/*.dossier.html

# 빌드 때 생성되는 사건 에셋 (scripts/build-case-assets.mjs)
public/cases/

# 빌드 때 생성되는 사건 목록 인덱스 (scripts/build-case-assets.mjs)
app/generated/
.dryrun-observation-to-card/

# 백그라운드 에이전트용 git worktree 스크래치 디렉터리
.claude/worktrees/
