{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detective.local/schemas/case_master.schema.json",
  "title": "Detective Case Master",
  "description": "추리 게임 사건 Master의 구조화 스키마. raw_text 프리텍스트 대신 이 형식으로 생성/검증한다.",
  "type": "object",
  "required": [
    "case_identity",
    "key_figures",
    "opening_scene",
    "ending_scene",
    "surface_incident",
    "full_truth",
    "actual_timeline",
    "characters",
    "locations",
    "evidence",
    "contradiction_stages",
    "red_herrings",
    "case_complete",
    "final_deduction",
    "ending_explanation"
  ],
  "additionalProperties": false,
  "properties": {
    "case_identity": {
      "type": "object",
      "required": ["case_id", "title", "genre", "setting", "detective_entry_type", "detective_entry", "tone"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "pattern": "^CASE\\d{3}$" },
        "title": { "type": "string" },
        "english_title": { "type": "string" },
        "genre": { "type": "string" },
        "setting": { "type": "string" },
        "detective_entry_type": {
          "type": "string",
          "enum": [
            "travel", "personal_appointment", "event_attendance", "meal_or_rest",
            "transit", "unrelated_errand", "witnessed_incident",
            "invited_by_acquaintance", "onsite_recognized_and_asked",
            "personal_stake", "anonymous_tip_self_initiated", "curious_bystander",
            "group_member", "outdoor_recreation", "stranded_by_circumstance",
            "part_time_work"
          ],
          "description": "탐정이 이 사건에 개입하게 된 경로의 카테고리. 사건 생성 루틴이 case_registry.json에서 최근 3건의 값을 확인해 이번엔 겹치지 않는 값을 고른다. 'onsite_recognized_and_asked'는 탐정이 이미 그 장소/근처에 있다가 현장 인물이 그를 알아보고 그 자리에서 도움을 요청하는 것만 가리키며, 'anonymous_tip_self_initiated'는 익명 제보를 받고 탐정 스스로 판단해 찾아가는 것을 가리킨다 — 둘 다 사전에 전화·연락을 받고 현장으로 불려오는 것과는 다르다. 새 유형이 필요하면 기존 값과 의미가 겹치지 않는 값을 이 배열에 추가할 수 있다."
        },
        "detective_entry": {
          "type": "string",
          "description": "detective_entry_type을 구체적인 한두 문장으로 서술한다. 어떤 타입이든 탐정이 사건 발생 이전에 미리 전화·연락을 받고 현장으로 불려오는 설정은 금지한다 — 탐정은 이미 그 장소에 있었거나, 우연히 근처에 있다가 사건과 마주친다. '다급한 연락을 받고 왔다', '전화를 받고 왔다' 같은 상투적 문구를 반복해서 쓰지 않는다."
        },
        "tone": { "type": "string" }
      }
    },

    "opening_scene": {
      "type": "object",
      "required": ["location_id", "narrative"],
      "additionalProperties": false,
      "properties": {
        "location_id": { "$ref": "#/$defs/locationId" },
        "narrative": {
          "type": "string",
          "description": "이 텍스트는 ACTUAL_TIMELINE의 오프닝 구간 항목들을 문장화한 결과여야 하며, 여기서 새로운 시각·목격·소지품을 만들지 않는다. \"탐정은 [의뢰인]의 다급한 연락/신고를 받고 왔다\"류의 상투적 호출 문구로 시작하지 않는다 — 사건마다 반복되면 오프닝의 첫인상이 다 똑같아져 재미를 해친다. 필수: 한지우 혼자 한 줄 논평하고 끝나는 게 아니라, 탐정과 한지우가 짧게라도 대사를 주고받는 티키타카를 반드시 포함한다(예: 탐정이 한마디 던지면 한지우가 받아치거나, 한지우의 관찰에 탐정이 대꾸하는 식)."
        }
      }
    },

    "ending_scene": {
      "type": "object",
      "required": ["location_id", "narrative"],
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "$ref": "#/$defs/locationId",
          "description": "보통 FULL_TRUTH.responsible_character_id의 present_location, 즉 마지막 CONTRADICTION_STAGES 단계(to_stage가 최종 단계인 것)가 벌어지는 장소."
        },
        "narrative": {
          "type": "string",
          "description": "CASE_COMPLETE 달성 후 보여주는 결말 장면. 반드시 다음 세 가지로만 구성한다: (1) 마지막 CONTRADICTION_STAGES.release.scope에 이미 정의된 자백 내용, (2) FINAL_DEDUCTION의 동기·수법 요약을 대사·정황으로 옮긴 것, (3) RED_HERRINGS 중 '해소돼도 남는' 것으로 표시된 여운 한 가지를 에필로그로. 이 세 출처에 없는 새로운 사실, 새 인물의 반응, 새 사건을 여기서 창작하지 않는다 — OPENING_SCENE과 정확히 같은 규칙이다. 필수: 자백을 듣는 그 순간엔 한지우가 그저 침묵하거나 수첩을 덮는 것으로 끝내지 말고, 탐정과 한지우가 짧게 대사를 주고받는 티키타카를 반드시 포함한다(이 순간의 무게를 해치지 않게 가볍거나 유머러스한 톤은 쓰지 않는다). 다만 자백 이후 둘이 현장을 벗어나는 마지막 장면에서는 얘기가 다르다 — 긴장이 풀린 뒤이므로 여기서는 오히려 가볍고 유머러스한 티키타카(콜백 농담, 데드팬 등)를 넣어도 된다. 새 사실을 만들지 않는 원칙은 이 마지막 장면에도 그대로 적용된다."
        }
      }
    },

    "surface_incident": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },

    "full_truth": {
      "type": "object",
      "required": ["responsible_character_id", "motive", "method", "key_time_location", "cover_up"],
      "additionalProperties": false,
      "properties": {
        "responsible_character_id": { "$ref": "#/$defs/characterId" },
        "motive": { "type": "string" },
        "method": { "type": "string" },
        "key_time_location": { "type": "string" },
        "cover_up": { "type": "string" },
        "accomplice": { "type": "string" }
      }
    },

    "actual_timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "time", "location", "actors", "actual_action"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/timelineId" },
          "time": { "type": "string" },
          "location": { "$ref": "#/$defs/locationId" },
          "actors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "actual_action": {
            "type": "string",
            "description": "정확히 한 인물의 한 행동만 담는다. '~하고', '~한 뒤', '~하며' 같은 접속으로 서로 다른 목적의 두 행동을 이어붙이지 않는다. (이 규칙은 API 스키마로 강제되지 않으며 사후 검증기가 확인한다.)"
          },
          "world_fact": { "type": "string" }
        }
      }
    },

    "key_figures": {
      "type": "array",
      "description": "피해자/실종자처럼 ACTUAL_TIMELINE의 actors에는 등장하지만 면담 대상(characters)은 아닌 인물. knows/hidden_until이 없다.",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^V\\d{2}$" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": "string", "description": "예: missing, deceased" }
        }
      }
    },

    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "role", "present_location", "knows", "initial_claims",
          "initial_interview_range", "hidden_until", "knowledge_limits",
          "voice_profile", "pressure_responses"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/characterId" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "present_location": { "$ref": "#/$defs/locationId" },
          "knows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["fact_id", "content", "source"],
              "additionalProperties": false,
              "properties": {
                "fact_id": { "$ref": "#/$defs/factId" },
                "content": { "type": "string" },
                "source": { "type": "string" },
                "related_timeline": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/timelineId" }
                }
              }
            }
          },
          "initial_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim_id", "content", "truth_status"],
              "additionalProperties": false,
              "properties": {
                "claim_id": { "$ref": "#/$defs/claimId" },
                "content": { "type": "string" },
                "truth_status": { "type": "string", "enum": ["truth", "lie"] },
                "reason_for_limit_or_lie": { "type": "string" }
              }
            }
          },
          "initial_interview_range": {
            "type": "array",
            "items": { "$ref": "#/$defs/claimId" }
          },
          "hidden_until": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["fact_or_claim_id", "release_prerequisite", "release_trigger"],
              "additionalProperties": false,
              "properties": {
                "fact_or_claim_id": { "$ref": "#/$defs/referenceId" },
                "release_prerequisite": {
                  "$ref": "#/$defs/referenceId",
                  "description": "단일 조건만 허용. OR/복수 조건 금지 (배열이 아니라 문자열 하나여야 함)."
                },
                "release_trigger": { "$ref": "#/$defs/referenceId" }
              }
            }
          },
          "knowledge_limits": {
            "type": "array",
            "items": { "type": "string" }
          },
          "voice_profile": {
            "type": "object",
            "required": ["formality_register", "sentence_length_tendency", "verbal_tic"],
            "additionalProperties": false,
            "description": "이 인물의 고정된 말투 프로필. NPC 대사 생성 시 이걸 따라야 하며, Master의 증거·타임라인 서술체(분석적 어투)가 그대로 대사에 새어나오지 않게 하는 기준선이 된다.",
            "properties": {
              "formality_register": {
                "type": "string",
                "description": "이 인물이 시종일관 유지하는 기본 격식. 예: 격식체(합니다), 표준 존댓말(해요), 방어적 단답형."
              },
              "sentence_length_tendency": {
                "type": "string",
                "description": "평소 문장 길이 경향과, 압박받을 때 그게 어느 방향으로 바뀌는지(더 짧아짐/더 길어짐 등)."
              },
              "verbal_tic": {
                "type": "string",
                "description": "이 인물만의 말버릇·반복 표현 한두 개. 다른 인물과 겹치지 않게 한다."
              }
            }
          },
          "pressure_responses": {
            "type": "array",
            "minItems": 1,
            "description": "실제로는 2~4개여야 한다(사후 검증기가 확인). 이 인물과 관련된 hidden_until 조건이 아직 충족되지 않은 채로 같은 사안을 반복 추궁당했을 때, 순서대로 나오는 반응. 매번 같은 온도로 부인하지 않게 하기 위함이며, 여기서 새로운 사실이나 결정적 정보를 밝히지 않는다 — 태도·말투만 점점 방어적이거나 불안정해진다. 실제 자백은 여전히 hidden_until/contradiction_stages를 통해서만 풀린다.",
            "items": { "type": "string" }
          },
          "comic_tell": {
            "type": "string",
            "description": "선택 필드. 이 인물만의 코믹한 버릇 한 가지. case_identity.tone이 코믹 탐정물 계열일 때만 채운다. 무거운 톤의 사건이면 빈 문자열로 두거나 이 필드 자체를 생략한다."
          }
        }
      }
    },

    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "access", "base_description", "observation_rules", "detail_rules"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/locationId" },
          "name": { "type": "string" },
          "access": { "type": "string" },
          "base_description": { "type": "string" },
          "observation_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["action", "release_fact_id", "result"],
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string",
                  "description": "런타임 매칭의 캐논 트리거 문구. 생성 시점과 런타임 조회 시점에 동일 문자열로 재사용된다."
                },
                "release_fact_id": { "$ref": "#/$defs/locationFactId" },
                "result": { "type": "string" }
              }
            }
          },
          "detail_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["action", "release_evidence_id", "result"],
              "additionalProperties": false,
              "properties": {
                "action": { "type": "string" },
                "requires": { "type": "string" },
                "release_evidence_id": { "$ref": "#/$defs/evidenceId" },
                "result": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "source_type", "found_at", "discovery_condition", "content", "proves", "does_not_prove", "presentation_effect"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/evidenceId" },
          "name": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["location", "testimony"],
            "description": "location: 장소를 조사해서 나옴 → discovery_condition이 found_at 장소의 detail_rules[].action과 문자 그대로 일치해야 함. testimony: NPC 면담으로 확보됨 → 별도 location 조사 항목과 매칭할 필요 없음."
          },
          "found_at": {
            "$ref": "#/$defs/locationId",
            "description": "location 타입이면 실제 발견 장소. testimony 타입이면 그 증언을 들을 수 있는 인물이 있는 장소. 정확히 하나의 위치만 가리켜야 한다."
          },
          "discovery_condition": {
            "type": "string",
            "description": "source_type이 location이면 해당 location의 detail_rules[].action과 정확히 동일한 문자열. testimony면 어떤 인물/조건으로 확보되는지 서술."
          },
          "related_timeline": {
            "type": "array",
            "items": { "$ref": "#/$defs/timelineId" }
          },
          "content": { "type": "string" },
          "proves": { "type": "array", "items": { "type": "string" } },
          "does_not_prove": { "type": "array", "items": { "type": "string" } },
          "presentation_effect": {
            "type": "array",
            "items": { "$ref": "#/$defs/referenceId" }
          }
        }
      }
    },

    "contradiction_stages": {
      "type": "array",
      "minItems": 1,
      "description": "실제로는 최소 3단계여야 하고 각 단계가 서로 다른 증거 조합을 요구해야 한다. (Claude 구조화 출력의 minItems는 0/1만 지원되어 여기서는 강제되지 않으며, 사후 검증기 validate_master.ts의 checkContradictionStages()가 확인한다.)",
      "items": {
        "type": "object",
        "required": [
          "id", "target_character", "from_stage", "to_stage",
          "requires_heard_claim_ids", "requires_presented_evidence_ids",
          "requires_comparison", "player_action", "release", "must_not_release"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/contradictionId" },
          "target_character": { "$ref": "#/$defs/characterId" },
          "from_stage": { "type": "string" },
          "to_stage": { "type": "string" },
          "requires_heard_claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/referenceId" }
          },
          "requires_presented_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/evidenceId" }
          },
          "requires_comparison": {
            "type": "object",
            "required": ["claim_id", "evidence_ids"],
            "additionalProperties": false,
            "properties": {
              "claim_id": { "$ref": "#/$defs/referenceId" },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/evidenceId" }
              }
            }
          },
          "player_action": { "type": "string" },
          "release": {
            "type": "object",
            "required": ["claim_or_fact_id", "scope"],
            "additionalProperties": false,
            "properties": {
              "claim_or_fact_id": { "$ref": "#/$defs/referenceId" },
              "scope": { "type": "string" }
            }
          },
          "must_not_release": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },

    "red_herrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "surface_suspicion", "actual_reason", "how_to_clear", "must_not_imply", "lingering_thread", "suspicion_deepener"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R\\d{2}$" },
          "surface_suspicion": { "type": "string" },
          "actual_reason": { "type": "string" },
          "how_to_clear": { "type": "string" },
          "must_not_imply": { "type": "string" },
          "lingering_thread": {
            "type": "string",
            "description": "이 red herring이 해소된 뒤에도 사건과 별개로 남는 여운. 없으면 빈 문자열. 최소 1개의 RED_HERRINGS는 이 필드를 채워야 하고, ENDING_SCENE의 에필로그는 그중 하나를 반드시 반영한다."
          },
          "suspicion_deepener": {
            "type": "string",
            "description": "actual_reason으로 완전히 해소되기 전에, 오히려 이 인물에 대한 의심을 더 키우는 중간 정보. 이게 먼저 드러난 뒤에야 how_to_clear로 해소돼야 한다 — 레드헤링이 한 번에 풀리면 여러 용의자를 저울질하는 긴장감이 안 생기기 때문이다. 없으면 빈 문자열이되, 최소 1개의 RED_HERRINGS는 채워야 한다."
          }
        }
      }
    },

    "case_complete": {
      "type": "object",
      "required": ["required_established_facts", "required_contradiction_stages", "accusation_requirements"],
      "additionalProperties": false,
      "properties": {
        "required_established_facts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/referenceId" }
        },
        "required_contradiction_stages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contradictionId" }
        },
        "accusation_requirements": {
          "type": "object",
          "required": ["suspect", "method_fact", "motive_fact"],
          "additionalProperties": false,
          "properties": {
            "suspect": { "$ref": "#/$defs/characterId" },
            "method_fact": { "type": "string" },
            "motive_fact": { "type": "string" }
          }
        }
      }
    },

    "final_deduction": {
      "type": "object",
      "required": ["responsible", "method", "motive", "key_connection"],
      "additionalProperties": false,
      "properties": {
        "responsible": { "type": "string" },
        "method": { "type": "string" },
        "motive": { "type": "string" },
        "key_connection": { "type": "string" }
      }
    },

    "ending_explanation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },

  "$defs": {
    "characterId": { "type": "string", "pattern": "^CH\\d{2}$" },
    "locationId": { "type": "string", "pattern": "^L\\d{2}$" },
    "timelineId": { "type": "string", "pattern": "^T\\d{2}$" },
    "evidenceId": { "type": "string", "pattern": "^E\\d{2}$" },
    "contradictionId": { "type": "string", "pattern": "^C\\d{2}$" },
    "factId": { "type": "string", "pattern": "^F-CH\\d{2}-\\d{2}$" },
    "claimId": { "type": "string", "pattern": "^S-CH\\d{2}-\\d{2}$" },
    "locationFactId": { "type": "string", "pattern": "^F-L\\d{2}-OBS-\\d{2}$" },
    "referenceId": {
      "type": "string",
      "pattern": "^(F-CH\\d{2}-\\d{2}|F-L\\d{2}-OBS-\\d{2}|S-CH\\d{2}-\\d{2}|E\\d{2}|C\\d{2})$",
      "description": "fact/claim/evidence/contradiction-stage ID 중 하나를 가리키는 참조. 이 패턴에 안 맞으면 존재하지 않는 ID를 지어낸 것."
    }
  }
}
